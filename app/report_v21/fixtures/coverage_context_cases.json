{
  "cases": [
    {
      "name": "no_gbp_url",
      "context": {
        "url": "https://example.com/service",
        "page_type": "Service Page",
        "content_checked": true,
        "gbp_url": "",
        "gbp_data": {},
        "gbp_lookup_attempted": false,
        "sub_pages": [],
        "raw_content_length": 1200
      },
      "expected_gbp_status": "not_checked",
      "expected_gbp_checked": false
    },
    {
      "name": "gbp_url_empty_data",
      "context": {
        "url": "https://example.com/service",
        "page_type": "Service Page",
        "content_checked": true,
        "gbp_url": "https://maps.google.com/?cid=123",
        "gbp_data": {},
        "gbp_lookup_attempted": true,
        "sub_pages": [],
        "raw_content_length": 1200
      },
      "expected_gbp_status": "not_found",
      "expected_gbp_checked": false
    },
    {
      "name": "gbp_data_present",
      "context": {
        "url": "https://example.com/service",
        "page_type": "Service Page",
        "content_checked": true,
        "gbp_url": "https://maps.google.com/?cid=123",
        "gbp_data": {
          "name": "Example Service",
          "address": "123 Main St",
          "data_id": "0x123:0x456",
          "review_list": [
            {"author": "A", "rating": 5, "text": "Great service"}
          ]
        },
        "gbp_lookup_attempted": true,
        "sub_pages": ["https://example.com/contact"],
        "raw_content_length": 2200
      },
      "expected_gbp_status": "checked",
      "expected_gbp_checked": true,
      "expected_reviews_checked": true,
      "expected_internal_pages_checked": true
    },
    {
      "name": "gbp_error",
      "context": {
        "url": "https://example.com/service",
        "page_type": "Service Page",
        "content_checked": true,
        "gbp_url": "https://maps.google.com/?cid=123",
        "gbp_data": {},
        "gbp_lookup_attempted": true,
        "gbp_error": "timeout",
        "sub_pages": [],
        "raw_content_length": 1200
      },
      "expected_gbp_status": "error",
      "expected_gbp_checked": false
    }
  ]
}
