# v1 保留 asyncio 进程内队列；v2.2 使用独立 Redis/ARQ Worker。

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="SEO Trust Path Analysis Service"
APP_VERSION="1.0.0"
DEBUG=false

# ── Dify ───────────────────────────────────────────────────────────────────────
# 在 Dify 控制台生成: https://cloud.dify.ai → 进入应用 → API → 生成
DIFY_API_KEY=app-your_dify_api_key
DIFY_API_URL=https://api.dify.ai/v1
DIFY_WORKFLOW_ID=your_dify_workflow_id
DIFY_STREAM_TIMEOUT=1200
DIFY_RETRY=3

# v2.2 uses a separate Dify app whose only job is selecting backend-owned
# copy patterns. Never point this at the legacy v2.1 report workflow.
V22_DIFY_API_KEY=app-your_v22_copy_app_key
V22_DIFY_API_URL=https://api.dify.ai/v1
V22_DIFY_COPY_MODEL_VERSION=dify-controlled-copy-v1
V22_DIFY_TIMEOUT_SECONDS=180
V22_SUPABASE_URL=https://your-project.supabase.co
V22_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
V22_RESULT_PERSISTENCE_TIMEOUT_SECONDS=30
TASK_STREAM_TIMEOUT=1260
TASK_STREAM_HEARTBEAT_INTERVAL=20

# ── SearchTrust v2.2 durable jobs ─────────────────────────────────────────────
# 在 v2.2 采集和报告管线完成验收前必须保持 false。
V22_ANALYZE_ENABLED=false
V22_GSC_SYNC_ENABLED=false
V22_GA4_SYNC_ENABLED=false
V22_GBP_SYNC_ENABLED=false
V22_GOOGLE_BROKER_ORIGIN=https://your-searchtrust-web-origin.example
V22_GOOGLE_BROKER_SECRET=replace-with-a-third-long-random-value
V22_REDIS_URL=redis://localhost:6379/0
V22_REDIS_PREFIX=searchtrust:v22
V22_QUEUE_NAME=searchtrust:v22:queue
V22_INTERNAL_API_TOKEN=replace-with-a-long-random-value
V22_CALLBACK_URL=http://localhost:3000/api/internal/v2/job-events
V22_CALLBACK_SECRET=replace-with-a-different-long-random-value
V22_CALLBACK_CLOCK_SKEW_SECONDS=300
V22_CALLBACK_TIMEOUT_SECONDS=5
V22_JOB_MAX_ATTEMPTS=3
V22_WORKER_CONCURRENCY=5
V22_JOB_TIMEOUT_SECONDS=3600
V22_JOB_STATE_TTL_SECONDS=604800
V22_JOB_HEARTBEAT_SECONDS=30
V22_JOB_STALE_SECONDS=180

# ── SearchTrust v2.2 preflight ────────────────────────────────────────────────
# 前端服务端代理和端到端验收完成前必须保持 false。
V22_PREFLIGHT_ENABLED=false
V22_PREFLIGHT_CACHE_TTL_SECONDS=900
V22_PREFLIGHT_CONNECT_TIMEOUT_SECONDS=5
V22_PREFLIGHT_READ_TIMEOUT_SECONDS=10
V22_PREFLIGHT_TOTAL_TIMEOUT_SECONDS=15
V22_PREFLIGHT_MAX_REDIRECTS=3
V22_PREFLIGHT_MAX_RESPONSE_BYTES=2000000

# ── SearchTrust v2.2 site inventory ──────────────────────────────────────────
# 后台库存阶段独立限流；不会打开完整 v2.2 分析入口。
V22_SITE_INVENTORY_CONCURRENCY=10
V22_SITE_INVENTORY_REQUESTS_PER_SECOND=5
V22_SITE_INVENTORY_CONNECT_TIMEOUT_SECONDS=5
V22_SITE_INVENTORY_READ_TIMEOUT_SECONDS=15
V22_SITE_INVENTORY_TOTAL_TIMEOUT_SECONDS=30
V22_SITE_INVENTORY_MAX_REDIRECTS=5
V22_SITE_INVENTORY_STRUCTURAL_BYTES=256000
V22_SITE_INVENTORY_DEEP_BYTES=2000000
V22_SITE_INVENTORY_SITEMAP_BYTES=2000000
V22_SITE_INVENTORY_SITEMAP_DECOMPRESSED_BYTES=10000000
V22_SITE_INVENTORY_SITEMAP_INDEX_DEPTH=2
V22_SITE_INVENTORY_SITEMAP_FILES=20
V22_SITE_INVENTORY_BATCH_SIZE=25
V22_SITE_INVENTORY_FIRECRAWL_ENABLED=true
V22_SERP_MARKET_CONNECT_TIMEOUT_SECONDS=5
V22_SERP_MARKET_READ_TIMEOUT_SECONDS=30
V22_SERP_MARKET_TOTAL_TIMEOUT_SECONDS=45
V22_SERP_MARKET_MAX_RESPONSE_BYTES=2000000
V22_COMPETITOR_DISCOVERY_ENABLED=false
V22_COMPETITOR_MARKET_TTL_SECONDS=86400
V22_COMPETITOR_STATE_TTL_SECONDS=604800
V22_COMPETITOR_CONNECT_TIMEOUT_SECONDS=5
V22_COMPETITOR_READ_TIMEOUT_SECONDS=30
V22_COMPETITOR_TOTAL_TIMEOUT_SECONDS=45
V22_COMPETITOR_MAX_RESPONSE_BYTES=2000000

# 可选：为空时 PageSpeed 模块在预检中标记为不可用。
PAGESPEED_API_KEY=

# ── SerpAPI ────────────────────────────────────────────────────────────────────
# 在控制台生成: https://serpapi.com/manage-api-key
SERPAPI_KEY=your_serpapi_key
# 可选：主 Key 额度耗尽、限流或失效时自动切换
SERPAPI_KEY_SECONDARY=your_secondary_serpapi_key
# 可选：前两个 Key 都不可用时自动切换
SERPAPI_KEY_TERTIARY=your_tertiary_serpapi_key
SERPAPI_LOCATIONS_URL=https://serpapi.com/locations.json

# ── Concurrency ───────────────────────────────────────────────────────────────
# 最大同时进行的分析任务数（asyncio 信号量控制）
MAX_CONCURRENT_REQUESTS=10

# ── Scraper ────────────────────────────────────────────────────────────────────
SCRAPER_TIMEOUT=30
SCRAPER_RETRY=3
SCRAPER_MIN_CONTENT_LENGTH=300

# Jina Reader — 留空则使用免费额度
JINA_API_KEY=

# Firecrawl — 付费备用抓取器
# 在控制台生成: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key
FIRECRAWL_API_URL=https://api.firecrawl.dev/v1

# ── Dify Global Rate Limiting (token bucket) ──────────────────────────────────
# 按照你的 OpenAI / Dify RPM 配额调整
DIFY_RPM_CAPACITY=60
DIFY_RPM_REFILL=60
DIFY_RPM_INTERVAL=60

# ── CORS ───────────────────────────────────────────────────────────────────────
# 逗号分隔或 JSON 数组: '["https://yourfrontend.com"]'
CORS_ORIGINS=["https://yourfrontend.com"]
