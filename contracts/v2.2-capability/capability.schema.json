          "type": "string"
        },
        "target": {
          "maxLength": 2000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "id",
        "rule_id",
        "rule_version",
        "classification",
        "severity",
        "confidence",
        "target",
        "observed_fact",
        "observed_at",
        "comparison_scope",
        "judgment",
        "interpretation",
        "impact_path",
        "evidence_ids",
        "limitations"
      ],
      "title": "CapabilityFinding",
      "type": "object"
