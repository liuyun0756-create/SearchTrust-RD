          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "User Id",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "report_id",
        "user_id",
        "case_id",
        "expected_revision",
        "source_checksum",
        "status",
        "title",
        "summary",
        "client_note",
        "actions"
      ],
